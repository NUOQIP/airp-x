# SAFE1: copy this file to .env. The API key stays on this computer.
AIRP_HOST=127.0.0.1
# 仅当你明确理解“无登录保护的所有数据与操作会暴露给网络”时才设为 true
AIRP_ALLOW_UNAUTHENTICATED_REMOTE=false
AIRP_PORT=4317
AIRP_WEB_ORIGIN=http://127.0.0.1:4318
AIRP_DATA_DIR=./data
AIRP_API_BASE_URL=https://api.openai.com/v1
AIRP_API_KEY=
AIRP_MODEL=
# Optional provider safety limits (defaults: 10 minutes and 16 MiB)
AIRP_AI_TIMEOUT_MS=600000
AIRP_AI_MAX_RESPONSE_BYTES=16777216
AIRP_AI_LOG_RETENTION_DAYS=30
AIRP_AI_LOG_MAX_FILE_BYTES=104857600
